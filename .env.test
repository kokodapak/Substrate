# =============================================
# Substrate Environment Configuration
# =============================================
# Copy this file to .env and fill in your values.
# Never commit .env or .env.local to version control.

# --- Required ---

# Admin API key — used for privileged operations (scan, rule management, etc.)
SUBSTRATE_ADMIN_KEY=your-admin-key-here

# Agent API key — used by AI agents to claim and complete tasks
SUBSTRATE_AGENT_KEY=your-agent-key-here

# SQLite database path (e.g. file:./data/substrate.db)
DATABASE_URL=file:./data/substrate.db

# Node environment: development | production | test
NODE_ENV=development

# Port the HTTP server listens on
PORT=4000

# --- Optional ---

# Path to Docker socket (default: /var/run/docker.sock)
# DOCKER_SOCKET_PATH=/var/run/docker.sock

# Sentry DSN for error tracking — if absent, Sentry is disabled silently
# SENTRY_DSN=https://your-dsn@o0.ingest.sentry.io/0
